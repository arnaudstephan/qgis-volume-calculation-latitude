            <number>10</number>
           </property>
           <item row="0" column="0">
            <widget class="QLabel" name="labelCloudResolution">
             <property name="toolTip">
              <string>Cell size of the DEM interpolated (TIN) from the points. About the mean point spacing is a good value.</string>
             </property>
             <property name="text">
              <string>TIN resolution</string>
             </property>
            </widget>
           </item>
           <item row="0" column="1">
            <widget class="QDoubleSpinBox" name="doubleSpinBoxCloudResolution">
             <property name="toolTip">
              <string>Cell size of the DEM interpolated (TIN) from the points. About the mean point spacing is a good value.</string>
             </property>
            </widget>
           </item>
           <item row="0" column="2">
            <widget class="QCheckBox" name="checkBoxGroundOnly">
             <property name="toolTip">
              <string>Keep only the points classified as ground (Classification = 2). Leave unchecked if the file already contains only ground points that are not classified.</string>
             </property>
             <property name="text">
              <string>Ground class only</string>
             </property>
            </widget>
           </item>
           <item row="1" column="0" colspan="3">
            <widget class="QCheckBox" name="checkBoxLoadCloudDem">
             <property name="toolTip">
              <string>Interpolates the WHOLE point cloud (not only the polygons area), saves the DEM next to the LAS file (name_DEM_TIN_resolution.tif) and adds it to the project as a hillshade, ready for print layouts. The file is reused by the next calculations as long as the LAS file and the settings do not change, and the layer already in the project is left untouched.</string>
             </property>
             <property name="text">
              <string>Keep the DEM of the whole cloud</string>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
